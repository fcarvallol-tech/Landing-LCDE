# ────────────────────────────────────────────────────────────────────────────
#  La Casa del Estratega — variables de entorno
#
#  Copia este archivo como `.env.local` y rellena los valores.
#  `.env.local` NUNCA se sube a git. Este archivo (`.env.example`) sí, pero
#  siempre vacío: nunca escribas un valor real acá.
#
#  Guía paso a paso para conseguir cada valor: PUESTA-EN-MARCHA.md
# ────────────────────────────────────────────────────────────────────────────

# ── Mercado Pago ────────────────────────────────────────────────────────────
# Access Token de la aplicación. SECRETO: solo servidor.
# Panel de Mercado Pago > Tus integraciones > tu aplicación > Credenciales.
# Empieza con APP_USR- (producción) o TEST- (pruebas).
MP_ACCESS_TOKEN=

# Clave secreta de firma del webhook. SECRETO: solo servidor.
# Panel de Mercado Pago > Tus integraciones > tu aplicación > Webhooks >
# Configurar notificación > "Revelar clave secreta".
MP_WEBHOOK_SECRET=

# Public Key de Mercado Pago. Es pública, puede estar en el navegador.
NEXT_PUBLIC_MP_PUBLIC_KEY=

# ── Supabase ────────────────────────────────────────────────────────────────
# URL del proyecto. Es pública. Ejemplo: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# service_role key. SECRETO ABSOLUTO: da acceso total a la base de datos.
# No la compartas con nadie, no la pegues en un chat, no la subas a git.
SUPABASE_SERVICE_ROLE_KEY=

# ── Correo (Resend) ─────────────────────────────────────────────────────────
# API key de Resend. SECRETO: solo servidor. Empieza con re_
# Si la dejas vacía la página funciona igual, pero no se envían correos.
RESEND_API_KEY=

# Remitente de los correos. El dominio debe estar verificado en Resend.
MAIL_FROM="La Casa del Estratega <pedidos@lacasadelestratega.cl>"

# Dónde llegan los avisos de pedido nuevo.
MAIL_ADMIN=fcarvallo@lacasadelestratega.cl

# ── Panel de administración ─────────────────────────────────────────────────
# Contraseña para entrar a /admin. SECRETO. Mínimo 12 caracteres.
ADMIN_PASSWORD=

# Frase larga y aleatoria usada para firmar la cookie de sesión del panel.
# SECRETO. Mínimo 32 caracteres. Genérala con: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# ── Analítica (opcional: la página funciona perfecto sin esto) ──────────────
# Si las dejas vacías, simplemente no se carga ningún píxel.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Sitio ───────────────────────────────────────────────────────────────────
# Dirección pública del sitio, sin barra al final.
# En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://lacasadelestratega.cl

# ── Content-Security-Policy ─────────────────────────────────────────────────
# "report-only" (por defecto) solo reporta en consola sin bloquear.
# "bloqueante" activa la protección de verdad. Ver PUESTA-EN-MARCHA.md.
CSP_MODO=report-only
